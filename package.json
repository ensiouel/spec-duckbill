{
  "name": "spec-duckbill",
  "version": "2.0.0",
  "description": "A file-first spec-driven development extension for Pi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0 <1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "keywords": [
    "pi-package",
    "spec-driven-development"
  ],
  "files": [
    "assets",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.mjs"
    ]
  }
}
